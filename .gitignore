# Generated Apple binaries, signatures, diagnostics, and local manifests.
payload/
logs/
DeviceCrashLogs/
*.dSYM/
*.ips
*.ips.ca.synced

# Diagnostics exports pulled off the device are large and local-only.
VirtualMac-Diagnostics-*/
